Discourse = { Sentence (_ PUNCT* _ Sentence)* #Discourse } EOF

BR = [\r\n]+
PUNCT = ';' / BR

Sentence = { ImpS _ { left:^ op:'↔' _ right:ImpS #Iff }* #Sentence }
ImpS = OrS _ { left:^ op:'→' _ right:OrS #Imp }*
OrS = AndS _ { left:^ op:'∨' _ right:AndS #Or }*
AndS = NotS _ { left:^ op:',' _ right:NotS #And }*
NotS = {{'¬' #Negation}* AtomS #Literal }
AtomS =
    { '|' _ Sentence _ QParen #Quantified }
    / { '(' _ Sentence _ ')' #Paren }
    / { LaTerm (_ LaTerm)* #AppLine }

LaTerm = {LTerm ('_' Alpha)? #LaTerm}
Alpha = {'I' / 'R' #Alpha}

LTerm = { Term ('^' (LQ / LPDQ))+ #ComplexLTerm }
    / { Term #SimpleLTerm }

Term = {
    Word / 'T' / Label
    / {'[' LTerm _ Func (_ LTerm)* ']' #Function}
    / {':' _ Sentence _ PDQParen #PullDown}
    #Term
}

PDQParen = { LsPDQ ':' #PDQParen }
QParen = { LsQ '|' #QParen }

LsPDQ = { PDQ ('-' Label)* #LsPDQ }
LPDQ = { PDQ ('-' Label)? #LPDQ }
LQ = { Q ('-' Label)? #LQ }
LsQ = { Q ('-' Label)* #LsQ }
PDQ = { 'L' / 'F' / 'J' #PDQ }
Q = { '∀' / '∃' #Q }


Word = { LOWERCASE #Word }
Func = { LOWERCASE #Func }
Label = { NUM #Label }

LOWERCASE = [a-z] [0-9a-z]*
UPPERCASE = [A-Z] [0-9A-Z]*
GREEKLETTER = [α-ωΑ-Ω] [0-9]*
NUM = [0-9]+