Discourse = { Sentence (_ PUNCT* _ Sentence)* #Discourse } EOF

BR = [\r\n]+
PUNCT = ';' / BR

Sentence = { ImpS _ { left:^ op:'↔' _ right:ImpS #Iff }* #Sentence }
ImpS = OrS _ { left:^ op:'→' _ right:OrS #Imp }*
OrS = AndS _ { left:^ op:'∨' _ right:AndS #Or }*
AndS = NotS _ { left:^ op:',' _ right:NotS #And }*
NotS = {{'¬' #Negation}* AtomS #Literal }
AtomS =
    { '|' _ Sentence _ QParen #Quantified }
    / { '(' _ Sentence _ ')' #Paren }
    / { (LTerm / Rel) (_ (LTerm / Rel))* #AppLine }

LTerm = { Term {'ι' #Indiv}? ('^' SupIndex+)? ('-' SubIndex)? #LTerm }

SupIndex = { LQ / LPDQ #SupIndex }
SubIndex = { Label #SubIndex }

Term = {
    Const / Class / 'T' / Label
    / {'[' LTerm _ Func (_ LTerm)* ']' #Function}
    / {':' _ Sentence _ PDQParen #PullDown}
    #Term
}

PDQParen = { LPDQ '.' #PDQParen }
QParen = { LQ '.' #QParen }

LPDQ = { PDQ { '*' #Star }? ('-' Label)? #LPDQ }
LQ = { Q { '*' #Star }? ('-' Label)? #LQ }
PDQ = { 'L' / 'Fn' / 'Fl' / 'J' #PDQ }
Q = { '∀' / '∃' #Q }


Const = { LOWERCASE #Const }
Class = { LOWERCASE #Class }
Func = { LOWERCASE #Func }
Rel = { LOWERCASE #Rel }
Label = { NUM #Label }

LOWERCASE = [a-z] [0-9a-z]*
UPPERCASE = [A-Z] [0-9A-Z]*
GREEKLETTER = [α-ωΑ-Ω] [0-9]*
NUM = [0-9]+